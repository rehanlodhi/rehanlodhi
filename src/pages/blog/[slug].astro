---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const displayDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
>
  <article>
    <header class="post-header block">
      <div class="block-inner">
        <div class="post-meta">
          <a href="/blog" class="post-back">← All posts</a>
          <span class="post-category">{post.data.category}</span>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-excerpt">{post.data.excerpt}</p>
        <time class="post-date" datetime={post.data.date}>{displayDate}</time>
      </div>
    </header>

    <div class="post-body block">
      <div class="block-inner post-content">
        <Content />
      </div>
    </div>
  </article>

  <ContactBlock compact />
</BaseLayout>

<style>
  .post-header { background: var(--zinc-50); }

  .post-header .block-inner {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .post-back {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zinc-500);
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-back:hover { color: var(--zinc-900); }

  .post-category {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--zinc-400);
    border: 1px solid var(--zinc-200);
    padding: 4px 10px;
  }

  .post-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(40px, 5vw, 72px);
    letter-spacing: 0.01em;
    color: var(--zinc-900);
    line-height: 1;
    margin-bottom: 1.5rem;
    max-width: 760px;
  }

  .post-excerpt {
    font-size: 18px;
    font-weight: 300;
    color: var(--zinc-500);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 2rem;
  }

  .post-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--zinc-400);
  }

  .post-content {
    max-width: 680px;
  }

  .post-content :global(p) {
    font-size: 16px;
    font-weight: 300;
    color: var(--zinc-600);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .post-content :global(h2) {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    color: var(--zinc-900);
    letter-spacing: 0.02em;
    margin-top: 3rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .post-content :global(h3) {
    font-size: 18px;
    font-weight: 600;
    color: var(--zinc-800);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    background: var(--zinc-100);
    border: 1px solid var(--zinc-200);
    padding: 2px 6px;
    color: var(--zinc-800);
  }

  .post-content :global(pre) {
    background: var(--zinc-900);
    border: 1px solid var(--zinc-800);
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--zinc-200);
    font-size: 13px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--zinc-300);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--zinc-500);
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--zinc-900);
    text-underline-offset: 3px;
  }
</style>
