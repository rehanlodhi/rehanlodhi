---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{compact ? (
  <section class="block contact-block contact-block--compact">
    <div class="block-inner">
      <div class="compact-inner">
        <div>
          <div class="block-label">Ready to talk?</div>
          <p class="compact-email">rehanlodhi@live.com</p>
        </div>
        <div class="compact-actions">
          <a href="https://linkedin.com/in/rehanlodhi" target="_blank" rel="noopener noreferrer" class="btn-outline">LinkedIn</a>
          <a href="https://github.com/rehanlodhi" target="_blank" rel="noopener noreferrer" class="btn-solid">GitHub</a>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="block contact-block" id="contact">
    <div class="block-inner">
      <div class="block-label">Get in Touch</div>
      <div class="contact-grid">
        <div>
          <h2 class="contact-heading">Let's<br />Work<br />Together.</h2>
          <p class="contact-subtext">
            Open to consulting engagements, technical advisory roles, and interesting
            open-source collaborations. Response time is typically under 48 hours.
          </p>
          <div class="contact-links">
            <a class="contact-link-item" href="mailto:rehanlodhi@live.com">
              <span class="contact-link-label">Email</span>
              <span class="contact-link-value">rehanlodhi@live.com</span>
            </a>
            <a class="contact-link-item" href="https://linkedin.com/in/rehanlodhi" target="_blank" rel="noopener noreferrer">
              <span class="contact-link-label">LinkedIn</span>
              <span class="contact-link-value">linkedin.com/in/rehanlodhi</span>
            </a>
            <a class="contact-link-item" href="https://github.com/rehanlodhi" target="_blank" rel="noopener noreferrer">
              <span class="contact-link-label">GitHub</span>
              <span class="contact-link-value">github.com/rehanlodhi</span>
            </a>
          </div>
        </div>
        <div class="contact-form-wrap">
          <form id="contact-form" novalidate>
            <div class="form-field">
              <label class="form-label" for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" class="form-input" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label class="form-label" for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" class="form-input" placeholder="your@email.com" required />
            </div>
            <div class="form-field">
              <label class="form-label" for="cf-subject">Subject</label>
              <input id="cf-subject" name="subject" type="text" class="form-input" placeholder="What's it about?" required />
            </div>
            <div class="form-field">
              <label class="form-label" for="cf-message">Message</label>
              <textarea id="cf-message" name="message" class="form-textarea" placeholder="Tell me about your project…" required></textarea>
            </div>
            <button type="submit" class="form-submit" id="cf-submit">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .contact-block { background: var(--zinc-900); }
  .contact-block .block-label { color: var(--zinc-600); }
  .contact-block .block-label::after { background: var(--zinc-700); }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 72px;
    line-height: 0.9;
    color: var(--zinc-50);
    letter-spacing: 0.01em;
    margin-bottom: 1.5rem;
  }

  .contact-subtext {
    font-size: 14px;
    color: var(--zinc-500);
    font-weight: 300;
    line-height: 1.7;
    max-width: 360px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--zinc-800);
    border: 1px solid var(--zinc-800);
    margin-top: 3rem;
  }

  .contact-link-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--zinc-900);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    transition: background 0.15s;
  }

  .contact-link-item:hover { background: var(--zinc-800); }

  .contact-link-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--zinc-500);
  }

  .contact-link-value {
    font-size: 14px;
    color: var(--zinc-300);
    font-weight: 400;
  }

  .contact-form-wrap { padding-top: 0.5rem; }

  .form-field { margin-bottom: 1.25rem; }

  .form-label {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--zinc-600);
    margin-bottom: 8px;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    background: var(--zinc-800);
    border: 1px solid var(--zinc-700);
    color: var(--zinc-200);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 14px;
    padding: 12px 14px;
    outline: none;
    font-weight: 300;
    transition: border-color 0.15s;
  }

  .form-input:focus,
  .form-textarea:focus { border-color: var(--zinc-500); }

  .form-textarea { resize: vertical; min-height: 100px; }

  .form-submit {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--zinc-900);
    background: var(--zinc-200);
    border: none;
    padding: 14px 32px;
    cursor: pointer;
    width: 100%;
    margin-top: 0.5rem;
    transition: background 0.15s;
  }

  .form-submit:hover { background: var(--zinc-50); }
  .form-submit:disabled { cursor: not-allowed; }

  /* Compact variant */
  .contact-block--compact .block-inner {
    padding: 3rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .compact-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .compact-email {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px;
    color: var(--zinc-100);
    letter-spacing: 0.02em;
    line-height: 1;
    margin-top: 0.75rem;
  }

  .compact-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-outline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--zinc-400);
    border: 1px solid var(--zinc-700);
    padding: 12px 24px;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .btn-outline:hover { border-color: var(--zinc-400); color: var(--zinc-200); }

  .btn-solid {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--zinc-900);
    background: var(--zinc-200);
    padding: 12px 24px;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-solid:hover { background: var(--zinc-50); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .contact-heading { font-size: 56px; }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('cf-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (btn) {
      btn.textContent = 'Message Sent ✓';
      btn.disabled = true;
      setTimeout(() => {
        btn.textContent = 'Send Message';
        btn.disabled = false;
        form.reset();
      }, 3000);
    }
  });
</script>
