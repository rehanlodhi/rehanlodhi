{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "672px",
			"wideSize": "700px"
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "8px",
					"slug": "8"
				},
				{
					"name": "X-Small",
					"size": "16px",
					"slug": "16"
				},
				{
					"name": "Small",
					"size": "24px",
					"slug": "24"
				},
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(30px, 7vw, 70px)",
					"slug": "70"
				},
				{
					"name": "X-Large",
					"size": "clamp(50px, 7vw, 90px)",
					"slug": "90"
				},
				{
					"name": "XX-Large",
					"size": "clamp(70px, 10vw, 140px)",
					"slug": "140"
				}
			]
		},
		"typography": {
			"writingMode": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Post Excerpt",
					"size": "1rem",
					"slug": "post-excerpt"
				},
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.38rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.75rem"
					},
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2.15rem"
					},
					"name": "Extra Extra Large",
					"size": "2.15rem",
					"slug": "xx-large"
				}
			],
			"fontFamilies": [
				{
					"fontFamily": "'Geist Sans', sans-sarif",
					"name": "Geist Sans",
					"slug": "geist-sans",
					"fontFace": [
						{
							"fontFamily": "Geist Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Geist/webfonts/Geist-Regular.woff2" ]
						}
					]
				},
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"
							],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				},
				{
					"name": "Fira Code",
					"slug": "fira-code",
					"fontFamily": "\"Fira Code\", monospace",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/fira-code/FiraCode-VariableFont_wght.woff2"
							],
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontFamily": "\"Fira Code\""
						}
					]
				}
			]
		},
		"color": {
			"custom": false,
			"palette": [
				{
					"name": "Text Primary",
					"slug": "text-primary",
					"color": "#222222"
				},
				{
					"name": "Text Secondary",
					"slug": "text-secondary",
					"color": "#737373"
				},
				{
					"name": "Border Color",
					"slug": "border",
					"color": "#e5e5e5"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "300",
			"letterSpacing": "1px",
			"lineHeight": "1.4"
		},
		"blocks": {
			"core/paragraph": {
				"color": {
					"text": "var:preset|color|text-primary"
				}
			},
			"core/post-excerpt": {
				"spacing": {
					"margin": {
						"top": "10px"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text-secondary"
						}
					}
				}
			},
			"core/post-date": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text-secondary"
						}
					}
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var:preset|color|border",
							"width": "1px"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"lineHeight": "1"
				}
			},
			"core/separator": {
				"border": {
					"width": "1px"
				}
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|black"
				},
				"typography": {
					"textDecoration": "none",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	],
	"version": 3
}
