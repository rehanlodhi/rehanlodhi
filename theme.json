{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "672px",
			"wideSize": "700px"
		},
		"spacing": {
			"units": [ "%", "px", "em", "rem", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Regular",
					"size": "clamp(30px, 5vw, 50px)",
					"slug": "50"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFamily": "'Geist Sans', sans-sarif",
					"name": "Geist Sans",
					"slug": "geist-sans",
					"fontFace": [
						{
							"fontFamily": "Geist Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/Geist/webfonts/Geist-Regular.woff2" ]
						}
					]
				}
			]
		},
		"color": {
			"custom": false,
			"palette": [
				{
					"name": "Text Primary",
					"slug": "text-primary",
					"color": "#222222"
				},
				{
					"name": "Text Secondary",
					"slug": "text-secondary",
					"color": "#737373"
				},
				{
					"name": "Border Color",
					"slug": "border",
					"color": "#e5e5e5"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|geist-sans"
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"letterSpacing": "0.5px",
					"lineHeight": "1.625"
				},
				"color": {
					"text": "var:preset|color|text-primary"
				}
			},
			"core/post-excerpt": {
				"spacing": {
					"margin": {
						"top": "10px"
					}
				},
				"typography": {
					"fontSize": "14px"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "18px"
				}
			},
			"core/post-terms": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text-secondary"
						}
					}
				}
			},
			"core/post-date": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text-secondary"
						}
					}
				}
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|black"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	],
	"version": 3
}
